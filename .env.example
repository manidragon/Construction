# Environment Variables for Coolify / Production
PORT=5000
NODE_ENV=production
DATABASE_URL="file:/app/data/prod.db"
JWT_SECRET="replace_with_a_secure_random_64_char_string"
JWT_EXPIRES_IN="7d"
UPLOAD_DIR="/app/data/uploads"

# Optional: Set to true on first deployment to seed default users and demo projects
SEED_DB="true"
